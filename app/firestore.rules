rules_version = '2';

// Staff are Firebase email/password accounts named <member>@alamsambung.app
// (see src/lib/identity.ts). The member is the part before the @. Keep the
// two lists below in sync with MEMBER_KEYS and ADMIN_KEYS in the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function memberKey() {
      return request.auth.token.email.split('@')[0];
    }

    function isMember() {
      return signedIn()
        && request.auth.token.email.matches('.*@alamsambung[.]app')
        && memberKey() in ['tuesday', 'skye', 'llymochi', 'ela'];
    }

    function isAdmin() {
      return isMember() && memberKey() in ['tuesday'];
    }

    // Selling someone else's product only changes its stock count.
    function onlyStockChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']);
    }

    function keepsOwner() {
      return request.resource.data.owner == resource.data.owner;
    }

    // Products: visitors may fetch ONE product by id (for its photo) but not
    // list the collection; they browse the compact catalog/public document.
    // Members edit their own; any member can adjust stock when selling.
    match /products/{productId} {
      allow get: if true;
      allow list: if isMember();
      allow create: if isMember()
        && (isAdmin() || request.resource.data.owner == memberKey());
      allow update: if isMember() && (
        isAdmin()
        || (resource.data.owner == memberKey() && keepsOwner())
        || onlyStockChanged()
      );
      allow delete: if isMember() && (isAdmin() || resource.data.owner == memberKey());
    }

    // Sales: created by the seller, never deleted. The seller or the admin
    // can void a sale (only the void fields may change).
    match /sales/{saleId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.staffId == memberKey()
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number;
      allow update: if isMember()
        && (isAdmin() || resource.data.staffId == memberKey())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidedAt']);
      allow delete: if false;
    }

    // Public catalog: one small document visitors read instead of every
    // product. Members' devices keep it in sync with the products.
    match /catalog/{docId} {
      allow read: if true;
      allow create, update: if isMember()
        && docId == 'public'
        && request.resource.data.keys().hasOnly(['items', 'hash', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
      allow delete: if false;
    }

    // Payment proof photos (compressed data URLs, under the 1 MiB document
    // limit). Kept apart from sales so the sales list stays small.
    match /proofs/{saleId} {
      allow read: if isMember();
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['dataUrl'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 900000;
      allow update, delete: if false;
    }
  }
}
